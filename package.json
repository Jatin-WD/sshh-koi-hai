{
  "name": "sshh-koi-hai",
  "private": true,
  "workspaces": [
    "client",
    "server"
  ],
  "overrides": {
    "esbuild": "0.28.2",
    "express": {
      "qs": "6.16.0"
    },
    "body-parser": {
      "qs": "6.16.0"
    }
  },
  "scripts": {
    "build": "npm run build -w server && npm run build -w client",
    "start": "node server/dist/index.js",
    "dev:server": "npm run dev -w server",
    "dev:client": "npm run dev -w client",
    "prisma:generate": "npm run prisma:generate -w server",
    "db:migrate": "npx prisma migrate deploy --schema server/prisma/schema.prisma",
    "db:recover": "node scripts/recover-production-migration.cjs",
    "prisma:migrate": "npm run prisma:migrate -w server",
    "prisma:seed": "npm run prisma:seed -w server"
  },
  "dependencies": {
    "qs": "6.16.0"
  }
}
