NODE_ENV=development
PORT=4000
LOG_LEVEL=debug
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/sshh_koi_hai
# Only enable this compatibility fallback if the hosting runtime cannot validate Supabase's CA.
DATABASE_SSL_ACCEPT_INVALID_CERTS=false
DATABASE_SSL_CA_BASE64=
# Set these to your public app URL in production if the frontend is hosted separately.
CLIENT_ORIGIN=http://localhost:5173
CORS_ORIGINS=http://localhost:5173
APP_URL=http://localhost:5173
FRONTEND_URL=http://localhost:5173
JWT_ACCESS_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30
EMAIL_VERIFICATION_TTL_HOURS=24
PASSWORD_RESET_TTL_MINUTES=60
CLIENT_APP_URL=http://localhost:5173
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your-smtp-user
SMTP_PASS=your-smtp-password
SMTP_FROM=info@sshhkoihai.com
SMTP_FROM_NAME=Sshh... Koi Hai?
ADMIN_ACTIVITY_EMAIL=contact.sshhkoihai@gmail.com
# The only email allowed to access the admin panel in production.
ADMIN_LOGIN_EMAIL=admin@example.com
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
# Optional alternative: cloudinary://api_key:api_secret@cloud_name
CLOUDINARY_URL=

# Seed only; never commit real credentials
ADMIN_EMAIL=admin@example.test
ADMIN_INITIAL_PASSWORD=replace-with-a-local-admin-password
DEMO_INITIAL_PASSWORD=replace-with-a-local-demo-password
TRAFFIC_MAX_CONCURRENT_REQUESTS=200
TRAFFIC_MAX_QUEUE_SIZE=500
TRAFFIC_QUEUE_TIMEOUT_MS=5000
REDIS_URL=redis://localhost:6379
REDIS_KEY_PREFIX=sshh:traffic
